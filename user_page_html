<!DOCTYPE html>
<html lang="zh-CN">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="styles.css">
  <title>个人信息填写</title>
</head>

<body>
  <div class="header">
    <h1>个人信息</h1>
  </div>
  <div class="info-container">
    <div class="info-item">
      <span class="label">姓名</span>
      <input type="text" class="input-value" placeholder="请输入姓名">
    </div>
    <div class="info-item">
      <span class="label">性别</span>
      <input type="text" class="input-value" placeholder="请输入性别">
    </div>
    <div class="info-item">
      <span class="label">所属学院</span>
      <input type="text" class="input-value" placeholder="请输入所属学院">
    </div>
    <div class="info-item">
      <span class="label">学号</span>
      <input type="text" class="input-value" placeholder="请输入学号">
    </div>
    <div class="info-item">
      <span class="label">专业</span>
      <input type="text" class="input-value" placeholder="请输入专业">
    </div>
  </div>
</body>

</html>
